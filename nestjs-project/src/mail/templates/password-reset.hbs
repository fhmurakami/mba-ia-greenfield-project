<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Reset your password – StreamTube</title>
  </head>
  <body>
    <p>Hello {{name}},</p>
    <p>
      We received a request to reset your StreamTube password. Click the link
      below to choose a new password:
    </p>
    <p>
      <a href="{{resetUrl}}">Reset Password</a>
    </p>
    <p>
      This link will expire in 1 hour. If you did not request a password reset,
      please ignore this email.
    </p>
  </body>
</html>
